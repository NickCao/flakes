use flake
if has sops; then
  export TF_ENCRYPTION=$(sops --extract '["tofu"]' -d infra/secrets.yaml)
fi

export SOPS_UPDATEKEYS="find . -regextype egrep -regex '.*secrets\.(yaml|env)' -exec sops updatekeys {} \;"
export TERRAFORM_VAULT_AUTH_JWT="$(spire-agent api fetch jwt -audience openbao -socketPath /run/spire/agent/public/api.sock -output json | jq -r '.[0].svids.[0].svid')"
